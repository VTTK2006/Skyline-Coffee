@model CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}
<section class="page-hero small"><h1>Thanh toán</h1><p>Điền thông tin giao hàng để hoàn tất đơn.</p></section>
<div class="checkout-layout">
    <form asp-action="Checkout" method="post" class="form-card">
        <h2>Thông tin giao hàng</h2>
        <label>Họ tên</label><input asp-for="FullName" /><span asp-validation-for="FullName"></span>
        <label>Số điện thoại</label><input asp-for="Phone" /><span asp-validation-for="Phone"></span>
        <label>Địa chỉ</label><input asp-for="Address" /><span asp-validation-for="Address"></span>
        <label>Ghi chú</label><textarea asp-for="Note"></textarea>
        <label>Thanh toán</label>
        <select asp-for="PaymentMethod"><option>Thanh toán khi nhận hàng</option><option>Chuyển khoản</option></select>
        <button class="btn" type="submit">Đặt hàng</button>
    </form>
    <aside class="summary-card">
        <h2>Đơn hàng</h2>
        @foreach (var item in Model.CartItems)
        {
            <p>@item.Product?.Name x @item.Quantity <strong>@(((item.Product?.Price ?? 0) * item.Quantity).ToString("N0"))đ</strong></p>
        }
        <hr />
        <h3>Tổng: @Model.TotalPrice.ToString("N0")đ</h3>
    </aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
