@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="auth-wrapper">
    <div class="auth-card">
        <form asp-action="Login" method="post">
            <h1>Đăng nhập</h1>
            <p>Chào mừng bạn quay lại SkyLine Coffee.</p>
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            
            <label asp-for="EmailOrUsername">Email hoặc tên đăng nhập</label>
            <input asp-for="EmailOrUsername" autocomplete="username" />
            <span asp-validation-for="EmailOrUsername"></span>
            
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
            
            <label class="checkbox">
                <input asp-for="RememberMe" /> Ghi nhớ đăng nhập
            </label>
            <button class="btn" type="submit">Đăng nhập</button>
        </form>

        <p class="mt-2 text-center" style="margin-top: 1rem; text-align: center;">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
