@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="auth-wrapper">
    <form asp-action="Login" method="post" class="auth-card">
        <h1>Đăng nhập</h1>
        <p>Chào mừng bạn quay lại Coffee House.</p>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <label>Email hoặc tên đăng nhập</label>
        <input asp-for="EmailOrUsername" />
        <span asp-validation-for="EmailOrUsername"></span>
        <label>Mật khẩu</label>
        <input asp-for="Password" />
        <span asp-validation-for="Password"></span>
        <label class="checkbox"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label>
        <button class="btn" type="submit">Đăng nhập</button>
        <p>Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
