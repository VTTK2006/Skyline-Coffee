@model VerifyPasswordResetViewModel
@{
    ViewData["Title"] = "Xác minh OTP";
}
<section class="auth-wrapper">
    <div class="auth-card">
        <form asp-action="VerifyOtp" method="post">
            <h1>Tạo mật khẩu mới</h1>
            <p>Nhập mã 6 chữ số đã gửi đến số điện thoại của bạn. Mã có hiệu lực trong 5 phút.</p>
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <input asp-for="Phone" type="hidden" />

            <label asp-for="Otp">Mã OTP</label>
            <input asp-for="Otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
            <span asp-validation-for="Otp"></span>

            <label asp-for="NewPassword">Mật khẩu mới</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>

            <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>

            <button class="btn" type="submit">Đổi mật khẩu</button>
        </form>
        <p class="auth-back"><a asp-action="ForgotPassword" asp-route-phone="@Model.Phone">Gửi mã khác</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }