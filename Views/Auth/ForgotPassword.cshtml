@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<section class="auth-wrapper">
    <div class="auth-card">
        <form asp-action="ForgotPassword" method="post">
            <h1>Quên mật khẩu</h1>
            <p>Nhập số điện thoại đã đăng ký để nhận mã xác minh qua SMS.</p>
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label asp-for="Phone">Số điện thoại</label>
            <input asp-for="Phone" type="tel" autocomplete="tel" inputmode="tel" />
            <span asp-validation-for="Phone"></span>

            <button class="btn" type="submit">Gửi mã OTP</button>
        </form>
        <p class="auth-back"><a asp-action="Login">Quay lại đăng nhập</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }