@using System.Security.Claims
@{
    var isLogged = User.Identity?.IsAuthenticated == true;
    var username = isLogged ? User.Identity!.Name : "";
    var avatar = User.FindFirst("AvatarUrl")?.Value ?? "/images/default-avatar.svg";
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkyGreen Coffee</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <nav class="navbar">
            <a asp-controller="Home" asp-action="Index" class="brand"><span class="brand-icon">🌿</span> SkyGreen Coffee</a>
            <button class="nav-toggle" type="button" aria-label="Mở menu">☰</button>
            <div class="nav-menu">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="Product" asp-action="Index">Sản phẩm</a>
                <a asp-controller="Product" asp-action="BestSeller">Best Seller</a>
                <a asp-controller="Product" asp-action="Trending">Trending</a>
                <a asp-controller="Home" asp-action="Promo">Combo / Khuyến mãi</a>
                <a asp-controller="Blog" asp-action="Index">Blog / Tin tức</a>
                <a asp-controller="Home" asp-action="About">Giới thiệu</a>
                <a asp-controller="Contact" asp-action="Index">Liên hệ</a>
                <a asp-controller="Cart" asp-action="Index" class="cart-link">🛒 Giỏ hàng</a>
                @if (isLogged)
                {
                    <div class="account-dropdown">
                        <button class="account-button" type="button">
                            <img src="@avatar" alt="Avatar" class="avatar-sm" />
                            <span>@username</span>
                        </button>
                        <div class="dropdown-menu">
                            <a asp-controller="Account" asp-action="Profile">Thông tin tài khoản</a>
                            <a asp-controller="Account" asp-action="MyOrders">Đơn hàng của tôi</a>
                            <a asp-controller="Account" asp-action="Addresses">Địa chỉ giao hàng</a>
                            <a asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                            @if (isAdmin)
                            {
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang quản trị</a>
                            }
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit">Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-small">Đăng nhập / Đăng ký</a>
                }
            </div>
        </nav>
    </header>

    <main class="page-content">
        @if (TempData["Success"] != null)
        {
            <div class="toast success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast error">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div>
            <h3>SkyGreen Coffee</h3>
            <p>Coffee, trà trái cây, nước ép và món ăn vặt với giao diện xanh da trời + xanh lá.</p>
        </div>
        <div>
            <strong>Liên hệ</strong>
            <p>123 Coffee Street, TP.HCM</p>
            <p>0900 000 000 - hello@skygreencoffee.vn</p>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
