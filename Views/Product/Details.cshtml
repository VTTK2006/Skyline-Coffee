@model Product
@{
    ViewData["Title"] = Model.Name;
}
<section class="details-layout">
    <div class="details-image"><img src="@(Model.ImageUrl ?? "/images/placeholder-product.svg")" alt="@Model.Name" /></div>
    <div class="details-info">
        <span class="badge">@Model.Category?.Name</span>
        <h1>@Model.Name</h1>
        <p>@Model.Description</p>
        <strong class="price-large" data-selected-price>@Model.GetPriceForSize("M").ToString("N0")đ</strong>
        <form asp-controller="Cart" asp-action="Add" method="post" class="detail-form">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <label>Size</label>
            <select name="size">
                <option value="S" data-price="@Model.GetPriceForSize("S")">S - @Model.GetPriceForSize("S").ToString("N0")đ</option>
                <option value="M" selected data-price="@Model.GetPriceForSize("M")">M - @Model.GetPriceForSize("M").ToString("N0")đ</option>
                <option value="L" data-price="@Model.GetPriceForSize("L")">L - @Model.GetPriceForSize("L").ToString("N0")đ</option>
            </select>
            <label>Topping</label>
            <select name="topping">
                <option value="" data-extra-price="0">Không topping</option>
                <option value="Trân châu" data-extra-price="@Model.GetToppingPrice("Trân châu")">Trân châu (+@Model.GetToppingPrice("Trân châu").ToString("N0")đ)</option>
                <option value="Kem cheese" data-extra-price="@Model.GetToppingPrice("Kem cheese")">Kem cheese (+@Model.GetToppingPrice("Kem cheese").ToString("N0")đ)</option>
                <option value="Thạch cà phê" data-extra-price="@Model.GetToppingPrice("Thạch cà phê")">Thạch cà phê (+@Model.GetToppingPrice("Thạch cà phê").ToString("N0")đ)</option>
            </select>
            <label>Số lượng</label>
            <input type="number" name="quantity" value="1" min="1" max="99" />
            <button class="btn" type="submit">Thêm vào giỏ hàng</button>
        </form>
    </div>
</section>
