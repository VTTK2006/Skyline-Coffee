@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<section class="auth-wrapper">
    <form asp-action="ChangePassword" method="post" class="auth-card">
        <h1>Đổi mật khẩu</h1>
        <label>Mật khẩu cũ</label><input asp-for="OldPassword" /><span asp-validation-for="OldPassword"></span>
        <label>Mật khẩu mới</label><input asp-for="NewPassword" /><span asp-validation-for="NewPassword"></span>
        <label>Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword"></span>
        <button class="btn" type="submit">Cập nhật mật khẩu</button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
