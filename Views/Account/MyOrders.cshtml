@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<section class="page-hero small">
    <h1>Đơn hàng của tôi</h1>
    <p>Theo dõi trạng thái các đơn bạn đã đặt.</p>
</section>

@if (!Model.Any())
{
    <section class="empty-state">
        <p>Bạn chưa có đơn hàng nào.</p>
        <a asp-controller="Product" asp-action="Index" class="btn">Khám phá menu ngay</a>
    </section>
}
else
{
    <div style="overflow-x: auto; margin-top: 1.5rem;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Phương thức</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong>#@order.Id</strong></td>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><strong>@order.TotalPrice.ToString("N0")đ</strong></td>
                    <td>@order.PaymentMethod</td>
                    <td><span class="status-pill">@order.Status</span></td>
                    <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-small btn-outline">Chi tiết</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
