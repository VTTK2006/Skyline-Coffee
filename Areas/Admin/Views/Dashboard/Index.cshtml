@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
}
<h1>Dashboard</h1>
<div class="stats-grid">
    <div class="stat-card"><span>Tổng doanh thu</span><strong>@Model.TotalRevenue.ToString("N0")đ</strong></div>
    <div class="stat-card"><span>Đơn hôm nay</span><strong>@Model.TodayOrders</strong></div>
    <div class="stat-card"><span>Đơn mới</span><strong>@Model.NewOrders</strong></div>
    <div class="stat-card"><span>Lượt truy cập hôm nay</span><strong>@Model.TodayVisits</strong></div>
    <div class="stat-card"><span>Khách hàng</span><strong>@Model.TotalCustomers</strong></div>
    <div class="stat-card"><span>Sản phẩm đang bán</span><strong>@Model.TotalProducts</strong></div>
    <div class="stat-card"><span>Món đã bán</span><strong>@Model.TotalSoldItems</strong></div>
</div>
<div class="chart-grid">
    <div class="panel"><h2>Doanh thu 7 ngày</h2><canvas id="revenueChart"></canvas></div>
    <div class="panel"><h2>Đơn hàng 7 ngày</h2><canvas id="orderChart"></canvas></div>
    <div class="panel wide"><h2>Top sản phẩm bán chạy</h2><canvas id="topProductsChart"></canvas></div>
</div>
<div class="panel">
    <h2>Đơn hàng mới nhất</h2>
    <table class="admin-table">
        <thead><tr><th>Mã</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Ngày đặt</th><th></th></tr></thead>
        <tbody>
        @foreach (var order in Model.LatestOrders)
        {
            <tr><td>#@order.Id</td><td>@order.FullName</td><td>@order.TotalPrice.ToString("N0")đ</td><td><span class="status">@order.Status</span></td><td>@order.CreatedAt.ToString("dd/MM HH:mm")</td><td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Xem</a></td></tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
<script>
const sky = '#0ea5e9';
const green = '#22c55e';
const teal = '#14b8a6';
const revenueLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByDay.Select(x => x.Label)));
const revenueData = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByDay.Select(x => x.Value)));
const orderLabels = @Html.Raw(JsonSerializer.Serialize(Model.OrdersByDay.Select(x => x.Label)));
const orderData = @Html.Raw(JsonSerializer.Serialize(Model.OrdersByDay.Select(x => x.Value)));
const topLabels = @Html.Raw(JsonSerializer.Serialize(Model.TopProducts.Select(x => x.Label)));
const topData = @Html.Raw(JsonSerializer.Serialize(Model.TopProducts.Select(x => x.Value)));
new Chart(document.getElementById('revenueChart'), { type: 'line', data: { labels: revenueLabels, datasets: [{ label: 'Doanh thu', data: revenueData, borderColor: sky, backgroundColor: 'rgba(14,165,233,.18)', tension:.35, fill:true }] } });
new Chart(document.getElementById('orderChart'), { type: 'bar', data: { labels: orderLabels, datasets: [{ label: 'Đơn hàng', data: orderData, backgroundColor: 'rgba(34,197,94,.75)', borderColor: green, borderWidth:1 }] } });
new Chart(document.getElementById('topProductsChart'), { type: 'bar', data: { labels: topLabels, datasets: [{ label: 'Số lượng bán', data: topData, backgroundColor: 'rgba(20,184,166,.75)', borderColor: teal, borderWidth:1 }] }, options: { indexAxis: 'y' } });
</script>
}
