@model Product
@{
    ViewData["Title"] = "Sửa món";
    var categories = ViewBag.Categories as List<Category> ?? new();
}
<div class="panel form-panel">
<h1>Sửa món</h1>
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="admin-form">
    <input type="hidden" asp-for="Id" />
    <label>Tên món</label><input asp-for="Name" />
    <img src="@(Model.ImageUrl ?? "/images/placeholder-product.svg")" class="preview-product" />
    <label>Đổi hình ảnh</label><input name="imageFile" type="file" accept=".jpg,.jpeg,.png" />
    <label>Giá bán</label><input asp-for="Price" type="number" />
    <label>Mô tả</label><textarea asp-for="Description"></textarea>
    <label>Danh mục</label><select asp-for="CategoryId">@foreach (var c in categories){<option value="@c.Id">@c.Name</option>}</select>
    <label>Trạng thái</label><select asp-for="Status"><option value="Available">Còn hàng</option><option value="Unavailable">Hết hàng</option></select>
    <label><input asp-for="IsBestSeller" /> Best Seller</label>
    <label><input asp-for="IsTrending" /> Trending</label>
    <button class="btn-admin" type="submit">Cập nhật</button>
</form>
</div>
