@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Thống kê";
}
<h1>Thống kê bán hàng</h1>
<div class="stats-grid">
    <div class="stat-card"><span>Tổng doanh thu</span><strong>@Model.TotalRevenue.ToString("N0")đ</strong></div>
    <div class="stat-card"><span>Đơn hôm nay</span><strong>@Model.TodayOrders</strong></div>
    <div class="stat-card"><span>Đơn mới</span><strong>@Model.NewOrders</strong></div>
    <div class="stat-card"><span>Số món đã bán</span><strong>@Model.TotalSoldItems</strong></div>
</div>
<div class="chart-grid">
    <div class="panel"><h2>Doanh thu 30 ngày</h2><canvas id="revenueChart"></canvas></div>
    <div class="panel"><h2>Số lượng đơn 30 ngày</h2><canvas id="orderChart"></canvas></div>
    <div class="panel"><h2>Top món bán chạy</h2><canvas id="topChart"></canvas></div>
    <div class="panel"><h2>Tỷ lệ trạng thái đơn</h2><canvas id="statusChart"></canvas></div>
</div>
@section Scripts {
<script>
const sky = '#0ea5e9';
const green = '#22c55e';
const teal = '#14b8a6';
const lime = '#84cc16';
const revenueLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByDay.Select(x => x.Label)));
const revenueData = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByDay.Select(x => x.Value)));
const orderData = @Html.Raw(JsonSerializer.Serialize(Model.OrdersByDay.Select(x => x.Value)));
const topLabels = @Html.Raw(JsonSerializer.Serialize(Model.TopProducts.Select(x => x.Label)));
const topData = @Html.Raw(JsonSerializer.Serialize(Model.TopProducts.Select(x => x.Value)));
const statusLabels = @Html.Raw(JsonSerializer.Serialize(Model.OrderStatusChart.Select(x => x.Label)));
const statusData = @Html.Raw(JsonSerializer.Serialize(Model.OrderStatusChart.Select(x => x.Value)));
new Chart(document.getElementById('revenueChart'), { type: 'line', data: { labels: revenueLabels, datasets: [{ label: 'Doanh thu', data: revenueData, borderColor: sky, backgroundColor: 'rgba(14,165,233,.18)', tension:.35, fill:true }] } });
new Chart(document.getElementById('orderChart'), { type: 'bar', data: { labels: revenueLabels, datasets: [{ label: 'Đơn hàng', data: orderData, backgroundColor: 'rgba(34,197,94,.75)', borderColor: green, borderWidth:1 }] } });
new Chart(document.getElementById('topChart'), { type: 'bar', data: { labels: topLabels, datasets: [{ label: 'Số lượng bán', data: topData, backgroundColor: 'rgba(20,184,166,.75)', borderColor: teal, borderWidth:1 }] }, options: { indexAxis: 'y' } });
new Chart(document.getElementById('statusChart'), { type: 'pie', data: { labels: statusLabels, datasets: [{ data: statusData, backgroundColor: [sky, green, teal, lime, '#38bdf8', '#86efac'] }] } });
</script>
}
